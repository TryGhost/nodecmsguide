{
  "name": "nodecmsguide",
  "version": "0.0.2",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "typecheck": "pnpm --dir tools/typecheck run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --reporter=list"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@octokit/rest": "22.0.1",
    "astro": "7.4.4",
    "date-fns": "4.4.0",
    "dotenv": "18.0.9",
    "fs-extra": "11.4.1",
    "lodash-es": "4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-share": "5.3.0",
    "slug": "12.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/fs-extra": "11.0.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "private": true
}
